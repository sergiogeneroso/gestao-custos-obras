spring.application.name=gestao-custos-obras
# ==========================
# Configurações do Servidor
# ==========================
server.port=8080

# ==========================
# Banco de Dados - PostgreSQL
# ==========================
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:gestao_custos_obras}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:admin}
spring.datasource.driver-class-name=org.postgresql.Driver

# ==========================
# JPA / Hibernate
# ==========================
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ==========================
# Flyway Migrations
# ==========================
# PAUSADO (ADR-013) enquanto a modelagem do MVP não fecha — schema por
# ddl-auto=update acima. FlywayConfig está sem @Configuration; reativar
# junto (ddl-auto=validate + religar @Configuration).
spring.flyway.enabled=false
spring.flyway.locations=classpath:db/migration

# ==========================
# JWT
# ==========================
# Secret HMAC-SHA256 (min. 32 chars). Em produção, injetar via env var.
app.jwt.secret=${JWT_SECRET:changeme-256-bits-min-32-chars-secret-key-dev-only}
app.jwt.expiration-minutos=${JWT_EXPIRATION_MINUTOS:120}

# ==========================
# Upload de Arquivos
# ==========================
# Diretório de armazenamento local (relativo à raiz do projeto)
app.upload.dir=${UPLOAD_DIR:uploads}
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=20MB
